# Platform-v2 Menu revision. Source the proven board, HPS, SDRAM, scaler, and
# OSD baseline, then replace only the platform services being rebuilt here.
set_global_assignment -name TOP_LEVEL_ENTITY de25_mister_top
set de25_platform_revision_owns_top_level 1
source DE25_MISTER_MENU.qsf
unset de25_platform_revision_owns_top_level

set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_menu_v2
source de25_platform_v2.qsf
