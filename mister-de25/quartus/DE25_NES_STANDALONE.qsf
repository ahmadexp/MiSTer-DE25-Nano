set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5EB013BB23BE4SCS
set_global_assignment -name TOP_LEVEL_ENTITY de25_nes_standalone_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "25.3 Pro Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_nes_standalone
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name PROJECT_IP_REGENERATION_POLICY ALWAYS_REGENERATE_IP
set_global_assignment -name VERILOG_CU_MODE MFCU

set_global_assignment -name VERILOG_MACRO "DE25_CORE_HAS_HDMI_BOB_DEINT=1"
set_global_assignment -name VERILOG_MACRO "DE25_CORE_HAS_SPLIT_SDRAM_DQ=1"
set_global_assignment -name VERILOG_MACRO "DE25_AGILEX_PLL_RECONFIG=1"
set_global_assignment -name VERILOG_MACRO "DE25_NES_CORE=1"
set_global_assignment -name VERILOG_MACRO "DE25_NES_GPI_DIAGNOSTIC=1"
set_global_assignment -name VERILOG_MACRO "DE25_NES_PIPELINE_DIAGNOSTIC=1"

set_global_assignment -name SEARCH_PATH ../rtl
set_global_assignment -name SEARCH_PATH ../upstream/cores/NES
set_global_assignment -name SEARCH_PATH ../upstream/cores/NES/sys
set_global_assignment -name SEARCH_PATH ../upstream/cores/NES/rtl

