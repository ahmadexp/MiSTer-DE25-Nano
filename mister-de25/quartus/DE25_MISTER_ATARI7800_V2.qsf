set_global_assignment -name TOP_LEVEL_ENTITY de25_mister_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_atari7800_v2
set_global_assignment -name VERILOG_MACRO "DE25_CORE_HAS_SDRAM=1"
set_global_assignment -name VERILOG_MACRO "DE25_CORE_HAS_SPLIT_SDRAM_DQ=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
source de25_atari7800_settings.tcl

set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Atari7800_MiSTer
set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Atari7800_MiSTer/sys
set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl

# MiSTer framework pieces used directly by Atari7800.sv.
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/sys/hps_io.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/sys/math.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/sys/video_freak.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/sys/video_freezer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/sys/gamma_corr.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/sys/hq2x.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/sys/video_mixer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/sys/ltc2308.sv

# Atari 7800 and Atari 2600 implementation. The official core exposes both
# systems through one persona and selects the machine from the cartridge.
# QIP assignments are reread by Quartus outside this QSF's Tcl scope. Keep
# these four paths literal so the compiler never persists "../upstream/official/MiSTer-devel_Atari7800_MiSTer" into
# the project database as an unresolved variable name.
set_global_assignment -name QIP_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/t65/t65.qip
set_global_assignment -name QIP_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/Pokey/Pokey.qip
set_global_assignment -name QIP_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/Maria/maria.qip
set_global_assignment -name QIP_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/jt51/jt51.qip
set_global_assignment -name VHDL_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/dpram.vhd
set_global_assignment -name VHDL_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/bram.vhd
set_global_assignment -name VHDL_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/ps2_keyboard.vhdl
set_global_assignment -name VHDL_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/ps2_to_pokey.vhdl
set_global_assignment -name VERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/souper.v
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/TIA.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/cart.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/cart2600.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/banks2600.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/video_mux.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/cofi.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/lightgun.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/paddles.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/mouse_st.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/EEPROM_24LC256.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/detect2600.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/RIOT/M6532.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/rtl/top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Atari7800_MiSTer/Atari7800.sv

set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/atari7800_core_pll_wrapper.sv
set_global_assignment -name QSYS_FILE ../ip/atari7800_core_pll.qsys
set_global_assignment -name IP_FILE ../ip/ip/atari7800_core_pll/atari7800_core_pll_iopll_0.ip

# Pack the dedicated captured_data stage into the HVIO input path. Its capture
# phase and following transfer stage explicitly close the board round trip.
set_instance_assignment -name FAST_INPUT_REGISTER ON -to DRAM_DQ[*]

source de25_simple_persona_base.qsf
source de25_platform_v2.qsf
set_global_assignment -name SDC_FILE DE25_MISTER_ATARI7800_V2.sdc
