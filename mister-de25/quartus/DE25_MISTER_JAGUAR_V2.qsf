set_global_assignment -name QIP_FILE ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/jaguar.qip
set_global_assignment -name VERILOG_FILE ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/nuked-68k/68k.v
set_global_assignment -name VERILOG_FILE ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/jag_controller_mux.v
set_global_assignment -name VERILOG_FILE ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/jag_team_tap.v
