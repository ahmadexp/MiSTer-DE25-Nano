set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jaguar_core_pll_wrapper.sv
set_global_assignment -name QSYS_FILE ../ip/jaguar_core_pll.qsys
set_global_assignment -name IP_FILE ../ip/ip/jaguar_core_pll/jaguar_core_pll_iopll_0.ip

# Keep the SDRAM return sampler in the Agilex I/O path. Command/address
# outputs can use pin registers, while DQ data and OE remain in the Jaguar
# controller because they change with its burst pipeline.
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DRAM_* -entity de25_mister_top
set_instance_assignment -name FAST_OUTPUT_REGISTER OFF -to DRAM_DQ[*] -entity de25_mister_top
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER OFF -to DRAM_DQ[*] -entity de25_mister_top
set_instance_assignment -name FAST_INPUT_REGISTER ON -to DRAM_DQ[*] -entity de25_mister_top

source de25_simple_persona_base.qsf
source de25_platform_v2.qsf
set_global_assignment -name SDC_FILE DE25_MISTER_JAGUAR_V2.sdc
