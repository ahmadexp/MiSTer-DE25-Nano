set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_jaguar_v2
set_global_assignment -name VERILOG_MACRO "DE25_CORE_HAS_SDRAM=1"
set_global_assignment -name VERILOG_MACRO "DE25_CORE_HAS_SPLIT_SDRAM_DQ=1"
set_global_assignment -name VERILOG_MACRO "DE25_JAGUAR_SAFE_CLOCK=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set DE25_SIMPLE_PERSONA_NATIVE_SDRAM 1

set core_root ../upstream/official/MiSTer-devel_Jaguar_MiSTer
set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Jaguar_MiSTer
set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Jaguar_MiSTer/sys
set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl
set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/Tom
set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/Jerry
set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/jaguar_common

set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Jaguar_MiSTer/sys/math.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Jaguar_MiSTer/sys/hps_io.sv
