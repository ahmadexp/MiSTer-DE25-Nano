set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/auto_crt_ar.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/jag_lightgun.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/numstick.sv
set_global_assignment -name VERILOG_FILE ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/eeprom_93c46_x16.v
set_global_assignment -name VERILOG_FILE ../upstream/official/MiSTer-devel_Jaguar_MiSTer/rtl/tda1545a.v
