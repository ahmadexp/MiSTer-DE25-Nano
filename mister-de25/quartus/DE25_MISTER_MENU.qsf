set_global_assignment -name VERILOG_FILE ../upstream/cores/Menu/sys/osd.v
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/cores/Menu/rtl/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/cores/Menu/rtl/ddram.sv
set_global_assignment -name VERILOG_FILE ../upstream/cores/Menu/rtl/lfsr.v
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/cores/Menu/rtl/cos.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/cores/Menu/menu.sv

