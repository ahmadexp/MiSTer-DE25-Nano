set_global_assignment -name TOP_LEVEL_ENTITY de25_mister_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_saturn_v2
set_global_assignment -name VERILOG_MACRO "DE25_HPS_BUS_49=1"
set_global_assignment -name VERILOG_MACRO "DE25_CORE_HAS_FB=1"
set_global_assignment -name VERILOG_MACRO "DE25_CORE_HAS_SDRAM=1"
set_global_assignment -name VERILOG_MACRO "DE25_CORE_HAS_SPLIT_SDRAM_DQ=1"
set_global_assignment -name VERILOG_MACRO "DE25_CORE_HAS_NATIVE_DDRAM_CLK=1"
set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"
set_global_assignment -name VERILOG_MACRO "LIGHT_SATURN=1"
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
# Saturn's dense DDRAM-to-core crossings need the maximum supported placement
# effort to retain useful setup margin across routes.
set_global_assignment -name PLACEMENT_EFFORT_MULTIPLIER 1.0
source de25_saturn_settings.tcl

set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Saturn_MiSTer
set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Saturn_MiSTer/sys
set_global_assignment -name SEARCH_PATH ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl

set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/sys/hps_io.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/sys/math.sv
# Quartus 25 resolves paths inside the upstream files.qip relative to this
# project. Spell out the short root manifest with unambiguous paths.
set_global_assignment -name QIP_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/FX68K/fx68k.qip
set_global_assignment -name QIP_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/SH/SH7604/SH7604.qip
set_global_assignment -name QIP_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/SH/SH7034/SH7034.qip
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/SH_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/SH7604_mem.sv
set_global_assignment -name QIP_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/ADSP_21xx/ADSP_2181.qip
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/ADSP_21XX_mem.sv
set_global_assignment -name QIP_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/Saturn/Saturn.qip
set_global_assignment -name VHDL_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/CEGen.vhd
set_global_assignment -name VHDL_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/bram.vhd
set_global_assignment -name VHDL_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/mlab.vhd
set_global_assignment -name VERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/hps_ext.v
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/sdram1.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/sdram2.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/ddram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/vdp1_fb.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/hps2pad.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/ps2mouse.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/ps2keyboard.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/lightgun.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/cofi.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/jtframe_resync.v
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/rtl/hps2cdd.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../upstream/official/MiSTer-devel_Saturn_MiSTer/Saturn.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/saturn_core_pll_wrapper.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/mister_sync_fix.sv
set_global_assignment -name QSYS_FILE ../ip/saturn_core_pll.qsys
set_global_assignment -name IP_FILE ../ip/ip/saturn_core_pll/saturn_core_pll_iopll_0.ip

source de25_simple_persona_base.qsf
source de25_platform_v2.qsf
set_global_assignment -name SDC_FILE DE25_MISTER_SATURN_V2.sdc
