#!/usr/bin/env python3
"""Read and verify the DE25 MemTest runtime-PLL diagnostic through HPS GPI."""

import argparse
import mmap
import os
import struct
import sys
import time


LW_BRIDGE_BASE = 0x20000000
LW_BRIDGE_SPAN = 0x00400000
GPO_OFFSET = 0x00020000
GPI_OFFSET = 0x00020010
HANDSHAKE_BIT = 1 << 31
DIAGNOSTIC_SHIFT = 21
DIAGNOSTIC_MASK = 0x3F
TRANSIENT_CODES = {62, 63}


def read_u32(mapping: mmap.mmap, offset: int) -> int:
    return struct.unpack_from("<I", mapping, offset)[0]


def write_u32(mapping: mmap.mmap, offset: int, value: int) -> None:
    struct.pack_into("<I", mapping, offset, value)


def diagnostic_code(mapping: mmap.mmap) -> tuple[int, int]:
    gpi = read_u32(mapping, GPI_OFFSET)
    return (gpi >> DIAGNOSTIC_SHIFT) & DIAGNOSTIC_MASK, gpi


def main() -> int:
    parser = argparse.ArgumentParser(
        description="verify a loaded DE25 MemTest PLL diagnostic image"
    )
    parser.add_argument("--expected", type=int, default=52)
    parser.add_argument("--samples", type=int, default=30)
    parser.add_argument("--interval", type=float, default=0.1)
    parser.add_argument("--timeout", type=float, default=5.0)
    args = parser.parse_args()

    if os.geteuid() != 0:
        parser.error("root is required to read the lightweight bridge")
    if not 0 <= args.expected <= DIAGNOSTIC_MASK:
        parser.error("--expected must be between 0 and 63")
    if args.samples < 1 or args.interval < 0 or args.timeout <= 0:
        parser.error("samples, interval, and timeout must be positive")

    with open("/dev/mem", "r+b", buffering=0) as device:
        mapping = mmap.mmap(
            device.fileno(),
            LW_BRIDGE_SPAN,
            flags=mmap.MAP_SHARED,
            prot=mmap.PROT_READ | mmap.PROT_WRITE,
            offset=LW_BRIDGE_BASE,
        )
        original_gpo = read_u32(mapping, GPO_OFFSET)
        try:
            write_u32(mapping, GPO_OFFSET, original_gpo | HANDSHAKE_BIT)
            deadline = time.monotonic() + args.timeout
            while True:
                code, gpi = diagnostic_code(mapping)
                if code not in TRANSIENT_CODES:
                    break
                if time.monotonic() >= deadline:
                    print(
                        f"FAIL: diagnostic remained transient at code {code} "
                        f"(GPI=0x{gpi:08X})",
                        file=sys.stderr,
                    )
                    return 1
                time.sleep(0.01)

            for sample in range(1, args.samples + 1):
                code, gpi = diagnostic_code(mapping)
                print(
                    f"sample {sample:02d}: PLL_DIAG={code} GPI=0x{gpi:08X}"
                )
                if code != args.expected:
                    print(
                        f"FAIL: expected diagnostic code {args.expected}",
                        file=sys.stderr,
                    )
                    return 1
                if sample != args.samples:
                    time.sleep(args.interval)
        finally:
            write_u32(mapping, GPO_OFFSET, original_gpo)
            mapping.close()

    print(
        f"PASS: PLL diagnostic code {args.expected} was stable for "
        f"{args.samples} samples"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
