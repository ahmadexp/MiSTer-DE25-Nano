[Unit]
Description=Keep the DE25-Nano HPS hardware watchdog serviced
After=dev-watchdog0.device

[Service]
Type=simple
ExecStart=/usr/libexec/mister-de25-watchdog-run --keeper /dev/watchdog0 90 /run/mister-de25-watchdog
Restart=always
RestartSec=1
RuntimeDirectory=mister-de25-watchdog
RuntimeDirectoryMode=0755
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
