+static int de25_check_rbf_compatibility(const char *rbf_path)
+{
+	pid_t child = fork();
+	if (child < 0) return -1;
+	if (!child) {
+		execl("/usr/libexec/mister-de25-check-rbf", "mister-de25-check-rbf",
+		      rbf_path, (char *)NULL);
+		_exit(127);
+	}
+
+	int status = 0;
+	while (waitpid(child, &status, 0) < 0) {
+		if (errno != EINTR) return -1;
+	}
+	if (!WIFEXITED(status) || WEXITSTATUS(status)) {
+		errno = EPERM;
+		return -1;
+	}
+	return 0;
+}
