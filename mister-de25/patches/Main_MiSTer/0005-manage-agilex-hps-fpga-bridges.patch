+static int de25_set_bridges(bool enable)
+{
+	pid_t child = fork();
+	if (child < 0) return -1;
+	if (!child) {
+		execl("/usr/libexec/mister-de25-bridge", "mister-de25-bridge",
+		      enable ? "enable" : "disable", (char *)NULL);
+		_exit(127);
+	}
+
+	int status = 0;
+	while (waitpid(child, &status, 0) < 0) {
+		if (errno != EINTR) return -1;
+	}
+	if (!WIFEXITED(status) || WEXITSTATUS(status)) {
+		errno = EIO;
+		return -1;
+	}
+	return 0;
+}
