From: DE25-Nano port
Subject: [PATCH] Keep DE25 relative pointer events shared with mousedev

The DE25 kernel exposes physical mouse motion through mousedev. An exclusive
EVIOCGRAB on the matching evdev interface starves mousedev, leaving Main's
/dev/input/mouseX stream empty. Keep relative pointer evdev nodes shared while
retaining exclusive grabs for keyboards and controllers.

diff --git a/input.cpp b/input.cpp
--- a/input.cpp
+++ b/input.cpp
@@ -1737,6 +1737,36 @@ static uint32_t tmp_axis[4];
 
 static int grabbed = 1;
 
+static int input_grab_value(int dev)
+{
+	int grab = (grabbed | user_io_osd_is_visible()) ? 1 : 0;
+
+#ifdef MISTER_DE25
+	// EVIOCGRAB on a relative-pointer evdev node prevents the kernel
+	// mousedev handler from receiving the same events. Main consumes motion
+	// through /dev/input/mouseX, so keep only these evdev nodes shared while
+	// retaining exclusive grabs for keyboards and controllers.
+	if (grab && dev >= 0 && dev < NUMDEV && pool[dev].fd >= 0 && !input[dev].mouse)
+	{
+		unsigned char evtype_b[(EV_MAX + 7) / 8] = {};
+		unsigned char rel_b[(REL_MAX + 7) / 8] = {};
+		unsigned char key_b[(KEY_MAX + 7) / 8] = {};
+
+		if (ioctl(pool[dev].fd, EVIOCGBIT(0, sizeof(evtype_b)), evtype_b) >= 0 &&
+			test_bit(EV_REL, evtype_b) && test_bit(EV_KEY, evtype_b) &&
+			ioctl(pool[dev].fd, EVIOCGBIT(EV_REL, sizeof(rel_b)), rel_b) >= 0 &&
+			ioctl(pool[dev].fd, EVIOCGBIT(EV_KEY, sizeof(key_b)), key_b) >= 0 &&
+			(test_bit(REL_X, rel_b) || test_bit(REL_Y, rel_b)) &&
+			test_bit(BTN_MOUSE, key_b))
+		{
+			return 0;
+		}
+	}
+#endif
+
+	return grab;
+}
+
 static uint32_t osd_timer = 0;
 static uint32_t map_advance_timer = 0;
 
@@ -5535,7 +5565,7 @@ int input_test(int getchar)
 						// use specific keyboard(s) as a joystick
 						for (int i = 0; i < (int)cfg.keyboard_as_joystick[0]; i++) input[n].force_joy = (input[n].vid == (cfg.keyboard_as_joystick[i + 1] >> 16) && input[n].pid == (cfg.keyboard_as_joystick[i + 1] & 0xFFFF));
 
-						ioctl(pool[n].fd, EVIOCGRAB, (grabbed | user_io_osd_is_visible()) ? 1 : 0);
+						ioctl(pool[n].fd, EVIOCGRAB, input_grab_value(n));
 
 						n++;
 						if (n >= NUMDEV) break;
@@ -6520,7 +6550,7 @@ void input_switch(int grab)
 
 	for (int i = 0; i < NUMDEV; i++)
 	{
-		if (pool[i].fd >= 0) ioctl(pool[i].fd, EVIOCGRAB, (grabbed | user_io_osd_is_visible()) ? 1 : 0);
+		if (pool[i].fd >= 0) ioctl(pool[i].fd, EVIOCGRAB, input_grab_value(i));
 	}
 }
 
