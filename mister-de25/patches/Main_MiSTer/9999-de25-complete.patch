+static int write_all(int out, const void *data, size_t size)
+{
+	const uint8_t *src = (const uint8_t *)data;
+	while (size) {
+		ssize_t written = write(out, src, size);
+		if (written < 0 && errno == EINTR) continue;
+		if (written <= 0) return -1;
+		src += written;
+		size -= written;
+	}
+	return 0;
