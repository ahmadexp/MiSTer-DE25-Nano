+#ifdef MISTER_DE25
+void x86_pc110_post_bypass()
+{
+	// The stock PC110 BIOS branches to its fatal POST screen when the
+	// conventional-memory diagnostic returns nonzero at F000:49F5. Keep the
+	// original ROM files intact, but replace that conditional branch in shared
+	// RAM while reset is asserted so hardware bring-up can continue to INT 19h.
+	// This command is deliberately explicit and is not part of normal x86_init.
+	x86_init();
+	user_io_status_set("[0]", 1);
+	// Let the core clock domain observe reset and discard every cached BIOS
+	// line before changing the shared LPDDR backing store.
+	usleep(100000);
+	if (!mem_set(0xF49F7, 0xEB, 1))
+		printf("PC110 POST bypass write failed.\n");
+	else
+		printf("PC110 POST bypass installed at F000:49F7.\n");
+	usleep(100000);
+	user_io_status_set("[0]", 0);
+}
+#else
+void x86_pc110_post_bypass()
+{
+	x86_init();
+}
+#endif
