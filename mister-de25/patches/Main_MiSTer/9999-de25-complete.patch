+	static const char configfs_root[] = "/sys/kernel/config";
+	static const char overlay_root[] = "/sys/kernel/config/device-tree/overlays";
+	static const char overlay_dir[] = "/sys/kernel/config/device-tree/overlays/mister-de25";
+	static const char overlay_dtbo[] = "/sys/kernel/config/device-tree/overlays/mister-de25/dtbo";
+
+	if (de25_load_region_driver() < 0) return -1;
+	if (mkdir(configfs_root, 0755) < 0 && errno != EEXIST) return -1;
+	if (access(overlay_root, F_OK) < 0) {
+		if (mount("configfs", configfs_root, "configfs", 0, NULL) < 0 && errno != EBUSY)
+			return -1;
+	}
+
+	if (rmdir(overlay_dir) < 0 && errno != ENOENT) return -1;
+	if (mkdir(overlay_dir, 0755) < 0) return -1;
+
+	if (copy_file_to_path(overlay_source, overlay_dtbo) < 0) {
+		int saved_errno = errno;
+		rmdir(overlay_dir);
+		errno = saved_errno;
+		return -1;
+	}
+
+	return 0;
+}
