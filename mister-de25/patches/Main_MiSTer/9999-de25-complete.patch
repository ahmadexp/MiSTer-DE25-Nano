+#ifdef MISTER_DE25
+// Agilex reserved LPDDR mappings reject the DC ZVA instruction used by
+// optimized AArch64 memset and report SIGBUS/BUS_ADRALN. Use explicit aligned
+// stores for the small x86 initialization regions, then complete all writes
+// before unmapping or releasing the core.
+static void de25_mapped_memset(void *buffer, uint8_t value, uint32_t size)
+{
+	volatile uint8_t *bytes = static_cast<volatile uint8_t *>(buffer);
+	uint64_t pattern = UINT64_C(0x0101010101010101) * value;
+
+	while (size && (reinterpret_cast<uintptr_t>(bytes) & 7))
+	{
+		*bytes++ = value;
+		size--;
+	}
+
+	volatile uint64_t *words =
+		reinterpret_cast<volatile uint64_t *>(bytes);
+	while (size >= sizeof(*words))
+	{
+		*words++ = pattern;
+		size -= sizeof(*words);
+	}
+
+	bytes = reinterpret_cast<volatile uint8_t *>(words);
+	while (size--)
+		*bytes++ = value;
+
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif
