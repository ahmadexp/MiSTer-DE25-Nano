+static int copy_file_to_path(const char *source_path, const char *target_path)
+{
+	int in = open(source_path, O_RDONLY | O_CLOEXEC);
+	if (in < 0) return -1;
+
+	int out = open(target_path, O_WRONLY | O_CLOEXEC);
+	if (out < 0) {
+		close(in);
+		return -1;
+	}
+
+	int result = 0;
+	uint8_t buffer[4096];
+	while (true) {
+		ssize_t count = read(in, buffer, sizeof(buffer));
+		if (count < 0 && errno == EINTR) continue;
+		if (count < 0 || (count > 0 && write_all(out, buffer, count) < 0)) {
+			result = -1;
+			break;
+		}
+		if (!count) break;
+	}
+
+	if (close(out) < 0) result = -1;
+	if (close(in) < 0) result = -1;
+	return result;
+}
