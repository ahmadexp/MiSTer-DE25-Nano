+	int result = write_all(out, rbf_data, rbf_size);
+	if (fsync(out) < 0) result = -1;
+	if (close(out) < 0) result = -1;
+	if (result < 0) {
+		printf("FPGA: unable to write firmware: %s\n", strerror(errno));
+		return -1;
+	}
+
+	if (de25_apply_fpga_overlay() < 0) {
+		printf("FPGA: unable to apply the DE25 FPGA-region overlay: %s\n", strerror(errno));
+		return -1;
+	}
+
+	for (unsigned int retry = 0; retry < 500; ++retry) {
+		char state[32] = {};
+		int in = open("/sys/class/fpga_manager/fpga0/state", O_RDONLY | O_CLOEXEC);
