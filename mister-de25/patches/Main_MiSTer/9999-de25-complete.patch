+static int de25_modprobe(const char *module)
+{
+	pid_t child = fork();
+	if (child < 0) return -1;
+	if (!child) {
+		execl("/sbin/modprobe", "modprobe", module, (char *)NULL);
+		execl("/usr/sbin/modprobe", "modprobe", module, (char *)NULL);
+		_exit(127);
+	}
+
+	int status = 0;
+	while (waitpid(child, &status, 0) < 0) {
+		if (errno != EINTR) return -1;
+	}
+	if (!WIFEXITED(status) || WEXITSTATUS(status)) {
+		errno = ENODEV;
+		return -1;
+	}
+	return 0;
