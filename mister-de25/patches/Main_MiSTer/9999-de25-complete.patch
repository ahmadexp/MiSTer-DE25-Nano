+static int de25_fpga_load(const void *rbf_data, size_t rbf_size)
+{
+	static const char firmware_path[] = "/lib/firmware/mister-de25-core.rbf";
+
+	int out = open(firmware_path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+	if (out < 0) {
+		printf("FPGA: unable to create %s: %s\n", firmware_path, strerror(errno));
+		return -1;
