 LD      = $(BASE)-ld
 STRIP   = $(BASE)-strip
+LIBCO   = lib/libco/arm.c
+IMLIB2_LIB = -Llib/imlib2 -lfreetype -lbz2 -lpng16 -lz -lImlib2
+BLUETOOTH_LIB = -Llib/bluetooth -lbluetooth
+endif
 
