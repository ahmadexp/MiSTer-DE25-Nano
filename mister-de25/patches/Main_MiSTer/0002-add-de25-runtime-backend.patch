+#ifdef MISTER_DE25
+static int write_all(int out, const void *data, size_t size)
+{
+	const uint8_t *src = (const uint8_t *)data;
+	while (size) {
+		ssize_t written = write(out, src, size);
+		if (written < 0 && errno == EINTR) continue;
+		if (written <= 0) return -1;
+		src += written;
+		size -= written;
+	}
+	return 0;
+}
+
+static int write_text_file(const char *path, const char *text)
+{
+	int out = open(path, O_WRONLY | O_CLOEXEC);
+	if (out < 0) return -1;
+	int result = write_all(out, text, strlen(text));
+	if (close(out) < 0) result = -1;
+	return result;
+}
+
+static int de25_fpga_load(const void *rbf_data, size_t rbf_size)
+{
+	static const char firmware_name[] = "mister-de25-core.rbf";
+	static const char firmware_path[] = "/lib/firmware/mister-de25-core.rbf";
+
+	int out = open(firmware_path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+	if (out < 0) {
+		printf("FPGA: unable to create %s: %s\n", firmware_path, strerror(errno));
+		return -1;
+	}
+
+	int result = write_all(out, rbf_data, rbf_size);
+	if (fsync(out) < 0) result = -1;
+	if (close(out) < 0) result = -1;
+	if (result < 0) {
+		printf("FPGA: unable to write firmware: %s\n", strerror(errno));
+		return -1;
+	}
+
+	if (write_text_file("/sys/class/fpga_manager/fpga0/firmware", firmware_name) < 0) {
+		printf("FPGA: Linux FPGA Manager rejected %s: %s\n", firmware_name, strerror(errno));
+		return -1;
+	}
+
+	for (unsigned int retry = 0; retry < 500; ++retry) {
+		char state[32] = {};
+		int in = open("/sys/class/fpga_manager/fpga0/state", O_RDONLY | O_CLOEXEC);
+		if (in >= 0) {
+			ssize_t count = read(in, state, sizeof(state) - 1);
+			close(in);
+			if (count > 0 && !strncmp(state, "operating", 9)) return 0;
+		}
+		usleep(10000);
+	}
+
+	printf("FPGA: timed out waiting for Linux FPGA Manager\n");
+	return -ETIMEDOUT;
+}
+#endif
+
 /* Timeout count */
 #define FPGA_TIMEOUT_CNT		0x1000000
 
