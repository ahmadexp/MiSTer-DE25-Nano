@@ -37,6 +29,28 @@ void *shmem_map(uint32_t address, uint32_t size)
 	return res;
 }
 
+void *shmem_map(uint32_t address, uint32_t size)
+{
+#ifdef MISTER_DE25
+	// MiSTer cores and Main agree on DE10 DDR offsets, including the control
+	// page below the normal 512 MiB core window. Agilex 5 LPDDR begins at
+	// 0x80000000, so translate the complete 1 GiB logical DDR address space.
+	if (address < 0x40000000)
+		address += 0x80000000;
+#endif
+
+	return shmem_map_address(address, size);
+}
+
+#ifdef MISTER_DE25
+void *shmem_map_physical(uint32_t address, uint32_t size)
+{
+	// HPS peripheral and bridge addresses must not pass through the logical
+	// MiSTer DDR translation performed by shmem_map().
+	return shmem_map_address(address, size);
+}
+#endif
+
 int shmem_unmap(void* map, uint32_t size)
 {
 	if (munmap(map, size) < 0)
