diff --git a/Atari7800.sv b/Atari7800.sv
--- a/Atari7800.sv
+++ b/Atari7800.sv
@@ -43,6 +43,8 @@ wire clock_locked;
 wire clk_vid;
 wire clk_sys;
 wire clk_tia;
+wire clk_sdram;
+wire clk_sdram_capture;
 
 pll pll
 (
@@ -51,6 +53,8 @@ pll pll
 	.outclk_0(clk_sys),
 	.outclk_1(clk_vid),
 	.outclk_2(clk_tia),
+	.outclk_3(clk_sdram),
+	.outclk_4(clk_sdram_capture),
 	.locked(clock_locked)
 );
 
@@ -589,6 +593,8 @@ sdram sdram
 
 	// system interface
 	.clk        ( clk_vid         ),
+	.clk_physical(clk_sdram       ),
+	.clk_capture( clk_sdram_capture),
 	.init       ( !clock_locked   ),
 
 	// cpu/chipset interface
diff --git a/rtl/sdram.sv b/rtl/sdram.sv
--- a/rtl/sdram.sv
+++ b/rtl/sdram.sv
@@ -44,6 +44,8 @@ module sdram
 	// cpu/chipset interface
 	input             init,			// init signal after FPGA config to initialize RAM
 	input             clk,			// sdram is accessed at up to 128MHz
+	input             clk_physical,	// phase-shifted clock forwarded to SDRAM
+	input             clk_capture,	// phase-shifted SDRAM input capture clock
 
 	input      [24:0] ch0_addr,
 	input             ch0_rd,
@@ -81,7 +83,10 @@ localparam STATE_IDLE  = 3'd0;             // state to check the requests
 localparam STATE_START = STATE_IDLE+1'd1;  // state in which a new command is started
 localparam STATE_NEXT  = STATE_START+1'd1; // state in which a new command is started
 localparam STATE_CONT  = STATE_START+RASCAS_DELAY;
-localparam STATE_READY = STATE_CONT+CAS_LATENCY+2'd1;
+// Returning DQ is captured after the SDRAM edge, transferred on clk's falling
+// edge, and consumed here one full state later. Keep busy asserted until this
+// state so clients cannot observe stale last_data.
+localparam STATE_READY = STATE_CONT+CAS_LATENCY+2'd2;
 localparam STATE_LAST  = STATE_READY;      // last state in cycle
 
 reg  [2:0] state;
@@ -167,6 +172,15 @@ localparam CMD_LOAD_MODE       = 3'b000;
 
 wire [1:0] dqm = {we & ~a[0], we & a[0]};
 reg [15:0] last_data;
+reg [15:0] captured_data;
+reg [15:0] piped_data;
+
+// Use an explicit related capture clock for the board round trip. The
+// falling-edge stage leaves a clean half-cycle transfer into clk's rising-edge
+// controller domain and avoids relying on an impossible pin-to-fabric
+// half-cycle path.
+always @(posedge clk_capture) captured_data <= sdram_dq_in;
+always @(negedge clk) piped_data <= captured_data;
 
 // SDRAM state machines
 always @(posedge clk) begin
@@ -206,7 +220,7 @@ always @(posedge clk) begin
 	if(state == STATE_READY) begin
 		if(ch0_busy) begin
 			if(ram_req) begin
-				if(!we) last_data <= sdram_dq_in;
+				if(!we) last_data <= piped_data;
 			end
 		end
 	end
@@ -214,7 +228,7 @@ end
 
 assign ch0_dout = we ? data[7:0] : a[0] ? last_data[15:8] : last_data[7:0];
 
-// The original constant high/low DDR output is exactly an inverted clock.
-assign SDRAM_CLK = ~clk;
+// Dedicated PLL output preserving the original 180 degree launch phase.
+assign SDRAM_CLK = clk_physical;
 
 endmodule
