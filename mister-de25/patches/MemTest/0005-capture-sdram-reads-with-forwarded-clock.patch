diff --git a/rtl/sdram.v b/rtl/sdram.v
index 615e3df..d9807e0 100644
--- a/rtl/sdram.v
+++ b/rtl/sdram.v
@@ -37,6 +37,7 @@ done  XXXXXXXX\_________ ....... _____________ .... ______________ .... ________
 module sdram
 (
 	input             clk,
+	input             clk_capture,
 	input             rst_n, // total reset
 
 	input             start, // start sequence
@@ -83,6 +84,6 @@ reg  [5:0] rcnt;
 reg        rnw_reg;
 reg  [1:0] rfsh;
-reg [15:0] rdat2, rdat3;
+reg [15:0] rdat_capture, rdat2, rdat3;
 reg        done3;
 reg [4:0]  is, is2, is3;
 reg [2:0]  st;
@@ -174,7 +175,7 @@ always @ (posedge clk) begin
 			DRAM_DQ_OE  <= 1'b1;
 		end
 
-		rdat3   <= DRAM_DQ_IN;
+		rdat3   <= rdat_capture;
 		rdat2   <= rdat3;
 		rdat    <= rdat2;
 		cmd2    <= CMD_NOP;
@@ -280,6 +281,14 @@ always @ (posedge clk) begin
 	end
 end
 
+// Capture returning data with the same phase-shifted clock that is forwarded
+// to the SDRAM. The following controller-clock stages preserve the original
+// read latency while giving the board-level round trip nearly a full cycle.
+always @ (posedge clk_capture) begin
+	if(!rst_n) rdat_capture <= 0;
+	else       rdat_capture <= DRAM_DQ_IN;
+end
+
 always @ (posedge clk) begin
 	if(!rst_n) begin
 		sdaddr <= 0;
