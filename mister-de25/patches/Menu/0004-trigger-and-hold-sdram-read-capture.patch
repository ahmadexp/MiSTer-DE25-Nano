diff --git a/rtl/sdram.sv b/rtl/sdram.sv
index 72279e6..dc2481b 100644
--- a/rtl/sdram.sv
+++ b/rtl/sdram.sv
@@ -88,10 +88,28 @@ reg        chip = 0;
 
 reg [15:0] data;
 reg [15:0] data_capture = '0;
+reg        read_capture_toggle = 1'b0;
+reg        read_capture_sync = 1'b0;
+reg        read_capture_seen = 1'b0;
 
 // Capture returning data with a phase-shifted clock derived alongside the
-// forwarded SDRAM clock. The controller consumes it on a later clk edge.
-always @(posedge clk_capture) data_capture <= SDRAM_DQ_IN;
+// forwarded SDRAM clock. The request toggle reaches this related clock domain
+// on the first capture edge. The next edge detects it and samples DQ after the
+// SDRAM CAS delay. The captured word remains stable until clk consumes it.
+always @(posedge clk_capture) begin
+	read_capture_sync <= read_capture_toggle;
+
+	if(read_capture_sync != read_capture_seen) begin
+		read_capture_seen <= read_capture_sync;
+		data_capture      <= SDRAM_DQ_IN;
+	end
+
+	if(init) begin
+		data_capture      <= '0;
+		read_capture_sync <= 1'b0;
+		read_capture_seen <= 1'b0;
+	end
+end
 
 assign SDRAM_nCS  = chip;
 assign SDRAM_nRAS = command[2];
@@ -253,6 +271,7 @@ always @(posedge clk) begin
 		STATE_READ: begin
 			state       <= STATE_IDLE_5;
 			command     <= CMD_READ;
+			read_capture_toggle <= ~read_capture_toggle;
 			data_ready_delay[CAS_LATENCY] <= 1;
 		end
 
@@ -268,6 +287,8 @@ always @(posedge clk) begin
 	if(init) begin
 		state <= STATE_STARTUP;
 		refresh_count <= startup_refresh_max - sdram_startup_cycles;
+		data_ready_delay <= '0;
+		read_capture_toggle <= 1'b0;
 	end
 
 	old_we <= we;
