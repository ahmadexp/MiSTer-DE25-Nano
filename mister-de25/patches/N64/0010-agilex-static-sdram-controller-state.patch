-
-	reg        saved_wr;
-	reg [12:0] cas_addr;
-	reg [31:0] saved_data;
-   reg  [3:0] saved_be;
-	reg [15:0] dq_reg;
-	reg  [3:0] state = STATE_STARTUP;
-
-	reg       ch1_rq, ch2_rq, ch3_rq;
