+// These variables are controller state, not procedural temporaries.  Quartus
+// 25 treats an initialized declaration inside an always block ambiguously and
+// can fold state to STATE_STARTUP, deleting every SDRAM data path.  Module
+// scope makes the intended static lifetime explicit and preserves the exact
+// cycle behavior of the original controller.
+reg [CAS_LATENCY+BURST_LENGTH:0] data_ready_delay1, data_ready_delay2, data_ready_delay3;
+reg        saved_wr;
+reg [12:0] cas_addr;
+reg [31:0] saved_data;
+reg  [3:0] saved_be;
+reg [15:0] dq_reg;
+reg  [3:0] state = STATE_STARTUP;
+reg        ch1_rq, ch2_rq, ch3_rq;
+reg  [1:0] ch;
 
 always @(posedge clk) begin
