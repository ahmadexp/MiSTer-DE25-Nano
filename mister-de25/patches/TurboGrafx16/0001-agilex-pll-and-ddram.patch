+// Agilex 5 compatibility implementation for TurboGrafx16's two mixed-width
+// save-memory instances. The native M20K primitive cannot expose one-bit byte
+// enables or mixed port widths, so both mappings use equal-width 16-bit ports.
+module dpram_difclk #(
+    parameter int addr_width_a  = 8,
+    parameter int data_width_a  = 8,
+    parameter int addr_width_b  = 8,
+    parameter int data_width_b  = 8,
+    parameter     mem_init_file = " "
+) (
+    input  wire                    clock0,
+    input  wire                    clock1,
+    input  wire [addr_width_a-1:0] address_a,
+    input  wire [data_width_a-1:0] data_a,
+    input  wire                    enable_a,
+    input  wire                    wren_a,
+    output wire [data_width_a-1:0] q_a,
+    input  wire                    cs_a,
+    input  wire [addr_width_b-1:0] address_b,
+    input  wire [data_width_b-1:0] data_b,
+    input  wire                    enable_b,
+    input  wire                    wren_b,
+    output wire [data_width_b-1:0] q_b,
+    input  wire                    cs_b
+);
+
+localparam bit IS_MB128 =
+    addr_width_a == 20 && data_width_a == 1 &&
+    addr_width_b == 16 && data_width_b == 16;
+localparam bit IS_BACKUP_RAM =
+    addr_width_a == 11 && data_width_a == 8 &&
+    addr_width_b == 10 && data_width_b == 16;
+
+generate
+if (IS_MB128) begin : mb128_mapping
+    wire [15:0] physical_q_a;
+    wire [15:0] physical_q_b;
+    wire [15:0] bit_mask = 16'b1 << address_a[3:0];
+    wire [15:0] physical_data_a = data_a[0] ?
+        (physical_q_a | bit_mask) : (physical_q_a & ~bit_mask);
+
+    altsyncram #(
+        .address_reg_b("CLOCK0"),
+        .clock_enable_input_a("BYPASS"),
+        .clock_enable_input_b("BYPASS"),
+        .clock_enable_output_a("BYPASS"),
+        .clock_enable_output_b("BYPASS"),
+        .indata_reg_b("CLOCK0"),
+        .init_file(mem_init_file),
+        .intended_device_family("Agilex 5"),
+        .lpm_type("altsyncram"),
+        .numwords_a(65536),
+        .numwords_b(65536),
+        .operation_mode("BIDIR_DUAL_PORT"),
+        .outdata_aclr_a("NONE"),
+        .outdata_aclr_b("NONE"),
+        .outdata_reg_a("UNREGISTERED"),
+        .outdata_reg_b("UNREGISTERED"),
+        .power_up_uninitialized("FALSE"),
+        .read_during_write_mode_port_a("DONT_CARE"),
+        .read_during_write_mode_port_b("DONT_CARE"),
+        .widthad_a(16),
+        .widthad_b(16),
+        .width_a(16),
+        .width_b(16),
+        .width_byteena_a(1),
+        .width_byteena_b(1),
+        .wrcontrol_wraddress_reg_b("CLOCK0")
+    ) ram (
+        .address_a(address_a[19:4]),
+        .address_b(address_b),
+        .byteena_a(1'b1),
+        .byteena_b(1'b1),
+        .clock0(clock0),
+        .data_a(physical_data_a),
+        .data_b(data_b),
+        .wren_a(wren_a && cs_a && enable_a),
+        .wren_b(wren_b && cs_b && enable_b),
+        .q_a(physical_q_a),
+        .q_b(physical_q_b)
+    );
+
+    assign q_a = !cs_a ? 1'b1 :
+                 (wren_a && enable_a) ? data_a :
+                 physical_q_a[address_a[3:0]];
+    assign q_b = !cs_b ? 16'hFFFF :
+                 (wren_b && enable_b) ? data_b : physical_q_b;
+end
+else if (IS_BACKUP_RAM) begin : backup_ram_mapping
+    wire [15:0] physical_q_a;
+    wire [15:0] physical_q_b;
+    wire [15:0] physical_data_a = address_a[0] ?
+        {data_a, 8'h00} : {8'h00, data_a};
+    wire [1:0] physical_byteena_a = address_a[0] ? 2'b10 : 2'b01;
+
+    altsyncram #(
+        .address_reg_b("CLOCK0"),
+        .byte_size(8),
+        .clock_enable_input_a("BYPASS"),
+        .clock_enable_input_b("BYPASS"),
+        .clock_enable_output_a("BYPASS"),
+        .clock_enable_output_b("BYPASS"),
+        .indata_reg_b("CLOCK0"),
+        .init_file(mem_init_file),
+        .intended_device_family("Agilex 5"),
+        .lpm_type("altsyncram"),
+        .numwords_a(1024),
+        .numwords_b(1024),
+        .operation_mode("BIDIR_DUAL_PORT"),
+        .outdata_aclr_a("NONE"),
+        .outdata_aclr_b("NONE"),
+        .outdata_reg_a("UNREGISTERED"),
+        .outdata_reg_b("UNREGISTERED"),
+        .power_up_uninitialized("FALSE"),
+        .read_during_write_mode_port_a("DONT_CARE"),
+        .read_during_write_mode_port_b("DONT_CARE"),
+        .widthad_a(10),
+        .widthad_b(10),
+        .width_a(16),
+        .width_b(16),
+        .width_byteena_a(2),
+        .width_byteena_b(2),
+        .wrcontrol_wraddress_reg_b("CLOCK0")
+    ) ram (
+        .address_a(address_a[10:1]),
+        .address_b(address_b),
+        .byteena_a(physical_byteena_a),
+        .byteena_b(2'b11),
+        .clock0(clock0),
+        .data_a(physical_data_a),
+        .data_b(data_b),
+        .wren_a(wren_a && cs_a && enable_a),
+        .wren_b(wren_b && cs_b && enable_b),
+        .q_a(physical_q_a),
+        .q_b(physical_q_b)
+    );
+
+    assign q_a = !cs_a ? 8'hFF :
+                 (wren_a && enable_a) ? data_a :
+                 (address_a[0] ? physical_q_a[15:8] : physical_q_a[7:0]);
+    assign q_b = !cs_b ? 16'hFFFF :
+                 (wren_b && enable_b) ? data_b : physical_q_b;
+end
+else begin : unsupported_mapping
+    assign q_a = {data_width_a{1'bx}};
+    assign q_b = {data_width_b{1'bx}};
+    initial $error("Unsupported TurboGrafx16 mixed-width RAM shape");
+end
+endgenerate
+
+// The two callers connect both legacy clock pins to clk_sys. Agilex 5 M20K
+// true dual-port mode requires that common clock, so clock1 is interface-only.
+wire _unused_clock1 = clock1;
+
+endmodule
