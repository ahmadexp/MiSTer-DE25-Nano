+localparam sdram_startup_cycles= 14'd12100;// >=100us for every supported rate
 localparam startup_refresh_max = 14'b11111111111111;
 
+// Leave enough margin for the longest in-flight GUS access before issuing an
+// AUTO REFRESH. The old fixed 780-cycle limit was valid only near 100 MHz and
+// under-refreshed the SDRAM at ao486's 56.25, 30, and 15 MHz profiles.
+function automatic [13:0] refresh_limit(input [27:0] rate);
+begin
+	case(rate)
+		100_000_000: refresh_limit = 14'd700;
+		 90_000_000: refresh_limit = 14'd630;
+		 56_250_000: refresh_limit = 14'd394;
+		 30_000_000: refresh_limit = 14'd210;
+		 15_000_000: refresh_limit = 14'd105;
+		default:     refresh_limit = 14'd630;
+	endcase
+end
+endfunction
+
+wire [13:0] cycles_per_refresh = refresh_limit(clock_rate);
