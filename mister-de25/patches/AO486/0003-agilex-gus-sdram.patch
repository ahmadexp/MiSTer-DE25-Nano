+reg old_we;
+reg old_rd;
+reg [CAS_LATENCY:0] data_ready_delay;
+reg [15:0] new_data;
+reg new_we;
+reg new_rd;
+reg save_we;
+state_t state;
 
+always @(posedge clk) begin
 	SDRAM_DQ_OE <= 1'b0;
 	command  <= CMD_NOP;
 	refresh_count  <= refresh_count+1'b1;
@@ -168,7 +193,7 @@ always @(posedge clk) begin
