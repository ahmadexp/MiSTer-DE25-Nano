 		refresh_count <= startup_refresh_max - sdram_startup_cycles;
+		data_ready_delay <= '0;
+		{old_we, old_rd, new_we, new_rd} <= '0;
+		new_data <= '0;
+		save_we <= 1'b1;
+		ready <= 1'b0;
+		SDRAM_DQ_OE <= 1'b0;
+		SDRAM_DQ_OUT <= '0;
+		command <= CMD_NOP;
 	end
 
 	old_we <= we;
