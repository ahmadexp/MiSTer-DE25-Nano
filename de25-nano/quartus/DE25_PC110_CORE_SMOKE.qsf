set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5EB013BB23BE4SCS
set_global_assignment -name TOP_LEVEL_ENTITY de25_pc110_core_smoke
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "25.3 Pro Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_core_smoke
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name PROJECT_IP_REGENERATION_POLICY ALWAYS_REGENERATE_IP
set_global_assignment -name VERILOG_CU_MODE MFCU
set_global_assignment -name AUTO_DISCOVERY_AND_SORT OFF

set_global_assignment -name SEARCH_PATH ../../rtl/ao486
set_global_assignment -name QIP_FILE ../../rtl/ao486/ao486.qip
set_global_assignment -name QIP_FILE ../../rtl/cache/cache.qip
set_global_assignment -name QIP_FILE ../../rtl/soc/uart/uart.qip
set_global_assignment -name QIP_FILE ../../rtl/soc/sound/opl3/opl3.qip
set_global_assignment -name VERILOG_FILE ../../rtl/soc/sound/sound.v
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/soc/sound/sound_dsp.v
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/soc/sound/saa1099.sv
set_global_assignment -name VERILOG_FILE ../../rtl/common/simple_fifo.v
set_global_assignment -name VERILOG_FILE ../../rtl/common/simple_fifo_mlab.v
set_global_assignment -name VERILOG_FILE ../../rtl/common/simple_mult.v
set_global_assignment -name VERILOG_FILE ../../rtl/common/simple_ram.v
set_global_assignment -name VERILOG_FILE ../../rtl/common/simple_rom.v
set_global_assignment -name VERILOG_FILE ../../rtl/common/simple_single_rom.v
set_global_assignment -name VHDL_FILE ../rtl/de25_bram.vhd
set_global_assignment -name VERILOG_FILE ../../rtl/soc/iobus.v
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/soc/floppy.v
set_global_assignment -name VERILOG_FILE ../../rtl/soc/ide.v
set_global_assignment -name VERILOG_FILE ../../rtl/soc/joystick.v
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/soc/dma.v
set_global_assignment -name VERILOG_FILE ../../rtl/soc/pic.v
set_global_assignment -name VERILOG_FILE ../../rtl/soc/pit.v
set_global_assignment -name VERILOG_FILE ../../rtl/soc/pit_counter.v
set_global_assignment -name VERILOG_FILE ../../rtl/soc/ps2.v
set_global_assignment -name VERILOG_FILE ../../rtl/soc/rtc.v
set_global_assignment -name VERILOG_FILE ../../rtl/soc/vga.v
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/pc110/pc110_chipset.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/pc110/pc110_ram_config.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/pc110/pc110_pcmcia_bridge.sv
set_global_assignment -name VERILOG_FILE ../../rtl/system.v
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/de25_pc110_core_smoke.sv
set_global_assignment -name QSYS_FILE ../ip/pc110_pll.qsys
set_global_assignment -name IP_FILE ../ip/ResetRelease.ip
set_global_assignment -name SDC_FILE DE25_PC110_CORE_SMOKE.sdc

set_instance_assignment -name IO_STANDARD "1.1-V" -to CLOCK0_50
set_location_assignment PIN_DJ35 -to CLOCK0_50

set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY[*]
set_location_assignment PIN_C8  -to KEY[0]
set_location_assignment PIN_C11 -to KEY[1]

set_instance_assignment -name IO_STANDARD "1.1-V" -to LED[*]
set_location_assignment PIN_DF35 -to LED[0]
set_location_assignment PIN_DJ32 -to LED[1]
set_location_assignment PIN_DN22 -to LED[2]
set_location_assignment PIN_DP23 -to LED[3]
set_location_assignment PIN_DN25 -to LED[4]
set_location_assignment PIN_DP25 -to LED[5]
set_location_assignment PIN_DJ27 -to LED[6]
set_location_assignment PIN_DP30 -to LED[7]

set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to FPGA_UART_TX
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to FPGA_UART_RX
set_location_assignment PIN_CJ1  -to FPGA_UART_TX
set_location_assignment PIN_BR19 -to FPGA_UART_RX

set_global_assignment -name USE_CONF_DONE SDM_IO16
set_global_assignment -name USE_HPS_COLD_RESET SDM_IO11
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "ACTIVE SERIAL X4"
set_global_assignment -name ACTIVE_SERIAL_CLOCK AS_FREQ_125MHZ
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
